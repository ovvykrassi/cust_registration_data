	<flow name="Consumer_Flow1" doc:id="25fa094c-cfae-4f19-a709-121738eccc7b" >
		<scheduler doc:name="Scheduler" doc:id="f3bde7f5-97d4-4643-bc4c-79431e4ff218" >
			<scheduling-strategy >
				<fixed-frequency frequency="30" timeUnit="SECONDS"/>
			</scheduling-strategy>
		</scheduler>
		<logger level="INFO" doc:name="" doc:id="1d545d24-c013-427e-a14d-7ad06023cdb5" message="----------------------------- Flow Started--------------------------"/>
		<os:retrieve doc:name="Retrieve" doc:id="e1353766-4069-4479-90a4-359d2b2eb844" key="CustomerID" target="watermark" objectStore="Object_store2">
			<os:default-value ><![CDATA[0]]></os:default-value>
		</os:retrieve>
		<logger level="INFO" doc:name="After_retriev" doc:id="e0353aee-ed50-44aa-8d67-d0ba839e9474" message="------------------------After_retriev------------------ #[payload]"/>
		<db:select doc:name="Select from DB1" doc:id="b5a70364-8796-4163-b2e9-14383b1d84a3" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT * from clients.customers WHERE CustomerID > :CustomerID ORDER BY CustomerID ASC LIMIT 100;]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
    CustomerID: vars.watermark
}]]]></db:input-parameters>
		</db:select>
		<logger level="INFO" doc:name="After_select_CustomerID" doc:id="b1abcf1f-911a-4f48-bafd-75478570fad8" message="----------------------- After_select_CustomerID-------------------  #[vars.watermark]"/>
		<os:store doc:name="Store" doc:id="717caf78-4207-45ff-b7bc-f0bc3ea8c582" key="CustomerID" objectStore="Object_store2">
			<os:value ><![CDATA[#[max (payload map $.CustomerID)]]]></os:value>
		</os:store>
		<logger level="INFO" doc:name="Logger" doc:id="a0efb3a0-62f1-4ea9-af5e-f04525018ab8" message="-----------------------Max-CustID-------------- [payload]"/>
		<batch:job jobName="Consumer_Batch_Job" doc:id="2170a327-24fc-491c-96a7-d1d1982f3f32" maxFailedRecords="-1">
			<batch:process-records >
				<batch:step name="Batch_Step" doc:id="8241a23a-9c94-45fa-bd3f-9436c1f101fc" >
					<logger level="INFO" doc:name="Logger" doc:id="ee0fc46a-0581-4eab-9d7d-d19e044ca4dc" message="----------------Before_publish_to_Activ_mq------------------------ #[payload]" />
					<ee:transform doc:name="Transform Message" doc:id="6811a418-32d7-40ab-96d3-c146aec5581e">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
						</ee:message>
					</ee:transform>
					<jms:publish doc:name="Publish" doc:id="6b7660f8-dc08-417a-bf38-b9e89e53aa5b" config-ref="JMS_Config" destination="Cust_Data"/>
					<!-- [STUDIO:"Batch Aggregator"]<batch:aggregator doc:name="Batch Aggregator" doc:id="ca4fa8cb-ea14-4f85-8d77-1d8607d90633" size="100">
						<logger level="INFO" doc:name="Logger" doc:id="dcc446fb-78b3-455c-918d-5ae75556e68d" message="&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-Bulk_insert_started&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;- #[payload&#93; "/>
						<db:bulk-insert doc:name="Bulk insert" doc:id="416458a2-d729-4754-95d5-a5c77e246496" config-ref="Database_Config">
							<db:bulk-input-parameters ><![CDATA[#[payload map {
	
  "FirstName": $.FirstName,
  "LastName": $.LastName,
  "Email": $.Email,
  "Age": $.Age
}&#93;&#93;&#93;></db:bulk-input-parameters>
							<db:sql ><![CDATA[INSERT INTO dataclient.custdata (FirstName, LastName, Email, Age) VALUES (:FirstName, :LastName, :Email, :Age)&#93;&#93;></db:sql>
						</db:bulk-insert>
					</batch:aggregator> [STUDIO] -->
				</batch:step>
			</batch:process-records>
			<batch:on-complete >
				<logger level="INFO" doc:name="Logger" doc:id="0f15b77e-a96d-41b6-a545-5d7d48dd6952" message="#[payload]"/>
				<ee:transform doc:name="Transform Message" doc:id="c6003b0b-384f-43e1-97dc-80bd0ea089e3" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"message": "Data published to Activ mq."
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</batch:on-complete>
		</batch:job>
