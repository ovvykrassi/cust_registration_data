	<jms:config name="JMS_Config" doc:name="JMS Config" doc:id="2f394e8c-f09f-4ee2-a802-34754fd353af" >
		<jms:active-mq-connection username="${jms.Username}" clientId="${jms.Client id}" >
			<jms:factory-configuration brokerUrl="tcp://Sura:61616" />
		</jms:active-mq-connection>
	</jms:config>
